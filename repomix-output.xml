<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#101511">
    <title>Lantern 0.9.1 · Authoring and Vertical Traversal</title>
    <link rel="stylesheet" href="./styles.css">
    <script type="importmap">
      {
        "imports": {
          "three": "./node_modules/three/build/three.webgpu.js",
          "three/webgpu": "./node_modules/three/build/three.webgpu.js",
          "three/tsl": "./node_modules/three/build/three.tsl.js",
          "three/addons/": "./node_modules/three/examples/jsm/"
        }
      }
    </script>
  </head>
  <body data-mode="play" data-developer-tools="closed">
    <header
      id="developer-toolbox"
      class="topbar"
      data-developer-surface
      aria-label="Developer toolbox"
    >
      <div class="brand-lockup">
        <span class="brand-mark" aria-hidden="true"></span>
        <div>
          <p class="eyebrow">Project Lantern / 0.9.1</p>
          <h1>Developer Toolbox</h1>
        </div>
      </div>
      <div class="run-summary" aria-label="Simulation status">
        <span id="run-status" class="status-pill">RUNNING</span>
        <span>tick <strong id="tick-value">0</strong></span>
        <span>seed <strong id="seed-value">--</strong></span>
      </div>
      <nav class="toolbar" aria-label="Developer controls">
        <button id="pause-button" type="button">Pause</button>
        <button id="step-button" type="button">Step</button>
        <button id="reset-button" type="button">Reset</button>
        <button id="mode-button" class="accent-button" type="button">Enter edit</button>
        <button id="focus-button" type="button">Focus</button>
        <button
          id="spell-lab-open"
          type="button"
          aria-expanded="false"
          aria-controls="spell-lab"
        >Spell Lab</button>
        <button id="ai-view-open" type="button" aria-expanded="false" aria-controls="ai-view-panel">AI View</button>
        <button id="render-lab-button" type="button" data-render-lab>Render Lab</button>
        <button
          id="developer-tools-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="developer-toolbox"
          aria-keyshortcuts=";"
        >Hide tools <kbd>;</kbd></button>
      </nav>
    </header>

    <main class="workspace">
      <section id="arena-viewport" class="arena-shell" aria-label="Lantern simulation viewport">
        <canvas id="arena" tabindex="0"></canvas>
        <canvas id="damage-number-overlay" aria-hidden="true"></canvas>
        <canvas id="ai-view-overlay" data-developer-surface aria-hidden="true" hidden></canvas>
        <div id="defeat-overlay" class="defeat-overlay" role="status" hidden>
          <strong>DEFEATED</strong>
          <span id="defeat-countdown">Restarting this seed in 1.5s</span>
        </div>
        <aside
          id="spell-lab"
          class="spell-lab"
          data-collapsed="true"
          data-developer-surface
          aria-label="Spell Lab authoring panel"
          hidden
        >
          <header class="spell-lab-heading">
            <div>
              <p class="eyebrow">Live definition authoring</p>
              <h2>Spell Lab</h2>
            </div>
            <button
              id="spell-lab-toggle"
              type="button"
              aria-expanded="false"
              aria-controls="spell-lab-body"
            >Expand</button>
          </header>
          <div id="spell-lab-body" class="spell-lab-body">
            <div class="spell-lab-selector">
              <label for="spell-selector">Spell</label>
              <select id="spell-selector"></select>
              <output id="spell-lab-status" data-valid="true" data-dirty="false">
                r1 · draft matches applied · valid
              </output>
            </div>

            <div class="spell-cast-controls">
              <button id="spell-recast" type="button" disabled>Recast last target</button>
              <label class="spell-seed-lock">
                <input id="spell-lock-seed" type="checkbox">
                Lock seed
              </label>
              <label class="spell-seed-field">
                Seed
                <input
                  id="spell-seed"
                  type="text"
                  value="0x00000000"
                  maxlength="10"
                  spellcheck="false"
                  inputmode="text"
                  aria-label="Hexadecimal variation seed"
                >
              </label>
              <button id="spell-new-variation" type="button">New variation</button>
              <button id="spell-clear" type="button">Clear active effects</button>
            </div>

            <p class="spell-formula">
              lifetime = clamp(base + size-scale × normalized-size +
              (lifetime-lane − 0.5) × jitter, minimum, maximum)<br>
              vertical velocity = minimum + range × vertical-lane<sup>power</sup>
            </p>

            <div id="spell-controls"></div>

            <pre id="spell-validation" class="spell-validation">
              Complete document valid. Apply affects future casts only.
            </pre>

            <div class="spell-lab-actions">
              <button id="spell-apply" class="accent-button" type="button">Apply</button>
              <button id="spell-revert" type="button">Revert to applied</button>
              <button id="spell-reset-defaults" type="button">Reset draft to defaults</button>
              <button id="spell-copy" type="button">Copy JSON</button>
              <button id="spell-download" type="button">Download JSON</button>
              <button id="spell-import" type="button">Import JSON</button>
              <input
                id="spell-import-input"
                type="file"
                accept="application/json,.json"
                hidden
              >
            </div>

            <section class="spell-diagnostics">
              <div class="section-heading">
                <h2>Spell diagnostics</h2>
                <span>captured revision truth</span>
              </div>
              <pre id="spell-lab-diagnostics">Waiting for the first fixed tick…</pre>
            </section>
          </div>
        </aside>
        <aside
          id="ai-view-panel"
          class="ai-view-panel"
          data-developer-surface
          aria-label="AI View diagnostics panel"
          hidden
        >
          <header class="ai-view-heading">
            <div>
              <p class="eyebrow">Read-only presentation</p>
              <h2>AI View</h2>
            </div>
            <button id="ai-view-close" type="button">Close</button>
          </header>
          <div class="ai-view-body">
            <fieldset class="ai-view-modes">
              <legend>Draw diagnostics</legend>
              <label><input type="radio" name="ai-view-mode" value="off" checked> Off</label>
              <label><input type="radio" name="ai-view-mode" value="selected"> Selected mob</label>
              <label><input type="radio" name="ai-view-mode" value="all"> All mobs</label>
            </fieldset>
            <label class="ai-view-selector" for="ai-view-mob">
              Selected mob
              <select id="ai-view-mob" disabled>
                <option value="">No living AI mobs</option>
              </select>
            </label>
            <output id="ai-view-status" class="ai-view-status" data-mode="off">
              View off · AI remains active
            </output>
            <p class="ai-view-note">
              This view never toggles mob AI. Diagnostics intentionally remain visible
              through TrueSight so hidden decisions can be inspected.
            </p>
            <section class="ai-view-diagnostics">
              <div class="section-heading">
                <h2>Selected mob</h2>
                <span>schema-v9 truth</span>
              </div>
              <pre id="ai-view-details">Waiting for a living AI mob. Selection is read-only.</pre>
            </section>
            <section class="ai-view-legend">
              <div class="section-heading"><h2>Overlay</h2><span>world-space vectors</span></div>
              <p><i data-ai-color="goal"></i>movement / search / guard <i data-ai-color="aim"></i>target / predicted aim</p>
              <p><i data-ai-color="sight"></i>mob sight cone / memory <i data-ai-color="threat"></i>tracked threat / dodge</p>
              <p>Investigation overlays add hearing, sound impact, projectile observation, reverse trajectory, and inferred origin.</p>
            </section>
          </div>
        </aside>
        <aside
          id="map-palette"
          class="editor-palette"
          data-developer-surface
          aria-label="Catalog-driven map palette"
        ></aside>
        <aside
          id="layer-panel"
          class="layer-panel"
          data-developer-surface
          aria-label="Map layer management and validation"
        ></aside>
        <aside
          id="authoring-inspector"
          class="authoring-inspector"
          data-developer-surface
          aria-label="Authoring selection inspector"
        ></aside>
        <div class="viewport-rail" data-developer-surface>
          <span id="pointer-value">x -- z -- · cell --</span>
          <span class="mode-hint play-hint">RMB move · LMB cast · click pins</span>
          <span class="mode-hint edit-hint">LMB uses tool · RMB channel-erase · drag moves · R rotates · MMB pans</span>
        </div>
        <div class="corner-readout" data-developer-surface aria-hidden="true">
          <span>X</span><i></i><span>Z</span>
        </div>
      </section>

      <aside class="instrument-panel" data-developer-surface aria-label="Developer instruments">
        <section class="panel-section telemetry-section">
          <div class="section-heading">
            <h2>Frame instrument</h2>
            <span>p50 / p95 / p99</span>
          </div>
          <pre id="telemetry-output">Waiting for first frame…</pre>
        </section>

        <section class="panel-section">
          <div class="section-heading"><h2>Bounded pools</h2><span>dense SoA</span></div>
          <div class="pool-readout">
            <div><span>Solid rocks</span><output id="rock-pool">0 / 64</output></div>
            <div class="meter rock-meter"><i id="rock-bar"></i></div>
          </div>
          <div class="pool-readout">
            <div><span>Enemy wizards</span><output id="enemy-pool">0 / 64</output></div>
            <div class="meter enemy-meter"><i id="enemy-bar"></i></div>
          </div>
          <div class="pool-readout">
            <div><span>Dynamic dead bodies</span><output id="dynamic-dead-body-pool">0 / 16</output></div>
            <div class="meter enemy-meter"><i id="dynamic-dead-body-bar"></i></div>
          </div>
          <div class="pool-readout">
            <div><span>Inert dead bodies</span><output id="inert-dead-body-pool">0 / 100</output></div>
            <div class="meter enemy-meter"><i id="inert-dead-body-bar"></i></div>
          </div>
          <div class="pool-readout">
            <div><span>Projectiles</span><output id="projectile-pool">0 / 256</output></div>
            <div class="meter"><i id="projectile-bar"></i></div>
          </div>
          <div class="pool-readout">
            <div><span>Sound events</span><output id="sound-event-pool">0 / 257</output></div>
            <div class="meter"><i id="sound-event-bar"></i></div>
          </div>
          <div class="pool-readout">
            <div><span>Particles</span><output id="particle-pool">0 / 4096</output></div>
            <div class="meter particle-meter"><i id="particle-bar"></i></div>
          </div>
        </section>

        <section class="panel-section inspector-section">
          <div class="section-heading"><h2>Inspector</h2><span>stable identity</span></div>
          <pre id="inspector-output">Move over the arena to inspect. Click to pin.</pre>
          <button id="despawn-enemy-button" class="danger-button" type="button" hidden disabled>
            Despawn pinned enemy
          </button>
        </section>

        <section class="panel-section">
          <div class="section-heading"><h2>Debug layers</h2><span>tick commands</span></div>
          <div class="flag-grid">
            <label><input type="checkbox" data-debug-flag="gridCoordinates" checked> Coordinates</label>
            <label><input type="checkbox" data-debug-flag="velocityVectors" checked> Vectors</label>
            <label><input type="checkbox" data-debug-flag="contacts" checked> Contacts</label>
            <label><input type="checkbox" data-debug-flag="explosionForces" checked> Blast forces</label>
            <label><input type="checkbox" data-debug-flag="particleStems" checked> Height stems</label>
            <label><input type="checkbox" data-debug-flag="particleBounce" checked> Ground bounce</label>
            <label><input type="checkbox" data-debug-flag="particleWallCollision" checked> Spark walls</label>
          </div>
        </section>

        <section class="panel-section">
          <div class="section-heading"><h2>Recent explosions</h2><span>ring buffer</span></div>
          <pre id="events-output">No explosions recorded.</pre>
        </section>

        <section class="panel-section data-section">
          <div class="section-heading"><h2>Artifacts</h2><span>JSON-safe</span></div>
          <div class="button-grid">
            <button id="save-map-button" type="button">Save scenario</button>
            <button id="load-map-button" type="button">Load scenario</button>
            <button id="snapshot-button" type="button">Snapshot</button>
            <button id="command-log-button" type="button">Command log</button>
          </div>
          <input id="map-file-input" type="file" accept="application/json,.json" hidden>
        </section>

        <section class="panel-section shortcut-section">
          <div class="section-heading"><h2>Shortcuts</h2><span>window.__lantern</span></div>
          <p><kbd>;</kbd> toolbox <kbd>Space</kbd> pause <kbd>.</kbd> one tick <kbd>R</kbd> reset <kbd>⇧R</kbd> new seed <kbd>E</kbd> mode <kbd>F</kbd> focus</p>
          <p><kbd>Wheel</kbd> zoom <kbd>MMB</kbd> edit pan</p>
        </section>

        <p id="error-output" class="error-output" role="alert" hidden></p>
      </aside>
    </main>
    <dialog id="render-lab-dialog" class="render-lab" data-render-lab data-developer-surface>
      <div class="render-lab-heading">
        <div>
          <p class="eyebrow">Presentation controls</p>
          <h2>Render Lab</h2>
        </div>
        <button id="render-lab-close" type="button" aria-label="Close Render Lab">Close</button>
      </div>

      <p id="render-lab-status" class="render-lab-status" role="status">
        URL settings are the only persisted state.
      </p>

      <div class="render-lab-grid">
        <section>
          <div class="section-heading"><h2>Startup topology</h2><span>reload required</span></div>
          <div class="render-control-grid">
            <label>Renderer
              <select data-presentation-option="renderer">
                <option value="2d">Canvas2D</option>
                <option value="3d">Three.js 3D</option>
              </select>
            </label>
            <label>Backend
              <select data-presentation-option="backend">
                <option value="auto">Automatic</option>
                <option value="webgl">Force WebGL 2</option>
              </select>
            </label>
            <label>Resident lights
              <select data-presentation-option="lights">
                <option value="8">8 · Low</option>
                <option value="16">16 · Balanced</option>
                <option value="32">32 · High</option>
                <option value="64">64 · Lab</option>
              </select>
            </label>
            <label class="render-check">
              <input type="checkbox" data-presentation-option="aa"> Antialiasing
            </label>
          </div>
        </section>

        <section>
          <div class="section-heading"><h2>Live settings</h2><span>applied immediately</span></div>
          <div class="render-control-grid">
            <label>Pixel-density cap
              <select data-presentation-option="dpr">
                <option value="1">1×</option>
                <option value="1.5">1.5×</option>
                <option value="2">2×</option>
              </select>
            </label>
            <label class="render-check">
              <input type="checkbox" data-presentation-option="dynamicLights"> Dynamic lights
            </label>
            <label class="render-check">
              <input type="checkbox" data-presentation-option="lightColorVariation"> Spell color variation
            </label>
            <label class="render-check">
              <input type="checkbox" data-presentation-option="bloom"> Bloom
            </label>
            <label class="render-check">
              <input type="checkbox" data-presentation-option="shadows"> Directional shadows
            </label>
            <label class="render-check">
              <input type="checkbox" data-presentation-option="trueSight"> TrueSight shroud
            </label>
            <label class="render-check">
              <input type="checkbox" data-presentation-option="sightFade"> Sight fading
            </label>
            <label class="render-check">
              <input type="checkbox" data-presentation-option="sightDebug"> Sight debug
            </label>
            <label class="render-check">
              <input type="checkbox" data-presentation-option="damageNumbers"> Damage numbers
            </label>
          </div>
        </section>
      </div>

      <section class="render-lab-diagnostic-section">
        <div class="section-heading"><h2>Live instrument</h2><span>current renderer</span></div>
        <pre id="render-lab-diagnostics">Renderer has not initialized yet.</pre>
      </section>

      <section id="render-lab-failure" class="render-lab-failure" hidden>
        <div class="section-heading"><h2>Renderer recovery</h2><span>initialization failed</span></div>
        <p id="render-lab-failure-message"></p>
        <div class="render-lab-actions">
          <button type="button" data-render-recovery="lower-lights">Lower light tier</button>
          <button type="button" data-render-recovery="webgl">Force WebGL 2</button>
          <button type="button" data-render-recovery="canvas">Use Canvas2D</button>
        </div>
      </section>

      <section>
        <div class="section-heading"><h2>Performance capture</h2><span>unscripted · ten seconds</span></div>
        <div class="render-lab-actions">
          <button id="render-lab-capture" type="button">Capture 10 seconds</button>
          <button id="render-lab-copy" type="button">Copy JSON</button>
          <button id="render-lab-download" type="button">Download JSON</button>
          <button id="render-lab-reload" type="button" hidden>Reload with settings</button>
        </div>
        <pre id="render-lab-report" class="render-lab-report">No performance report captured.</pre>
      </section>
    </dialog>
    <div id="toast" class="toast" role="status" aria-live="polite"></div>
    <script type="module" src="./src/main.js"></script>
  </body>
</html>
